# --- PostgreSQL / PostGIS ---
DATABASE_URL=postgresql+psycopg2://commuttify:commuttify@localhost:5433/commuttify

# --- Redis (live segment speeds; falls back to in-process cache if down) ---
REDIS_URL=redis://localhost:6380/0

# --- Static GTFS: put the full TransportStack download (unzipped .txt files) here ---
GTFS_DIR=C:\Users\Abhinav\commuttify\data\gtfs
GTFS_SAMPLE_DIR=C:\Users\Abhinav\commuttify\data\gtfs_sample

# --- Historical SQLite day files ---
HIST_DIR=C:\Users\Abhinav\Downloads\delhi_buses_dataset

# --- Live GTFS-RT (updates ~every 10 s) ---
GTFS_RT_URL=https://dts-backend.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb
GTFS_RT_KEY=
GTFS_RT_KEY_HEADER=x-api-key
GTFS_RT_POLL_SECONDS=10

# --- Validation (optional) ---
GOOGLE_MAPS_API_KEY=

# --- Chatbot LLM (optional, OpenAI-compatible; falls back to rule-based) ---
# Chatbot LLM — primary (OpenAI-compatible); empty key = rule-based replies
CHATBOT_LLM_URL=https://api.openai.com/v1/chat/completions
CHATBOT_LLM_MODEL=gpt-4o-mini
CHATBOT_LLM_KEY=
# Chatbot LLM — fallback: FreeLLMAPI router (https://github.com/tashfeenahmed/freellmapi)
# start it (docker compose up -d), add provider keys at http://localhost:3001,
# then paste the unified API key from its Keys page below
CHATBOT_FALLBACK_URL=http://localhost:3001/v1/chat/completions
CHATBOT_FALLBACK_MODEL=auto
CHATBOT_FALLBACK_KEY=
